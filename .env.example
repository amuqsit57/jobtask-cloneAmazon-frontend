# Copy to .env.local for development.
#
# NEXT_PUBLIC_API_URL must include the /api suffix and must NOT end in a slash:
#   right: https://your-api.onrender.com/api
#   wrong: https://your-api.onrender.com/api/     -> requests become //api/... -> 404
#   wrong: https://your-api.onrender.com          -> requests miss the /api prefix
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Any long random string. Generate one with: npx auth secret
AUTH_SECRET=change-me

# Required when the host terminates TLS for you (Vercel, Render).
AUTH_TRUST_HOST=true
